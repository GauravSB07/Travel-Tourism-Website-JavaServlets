<header class="admin-site-header">
<div class="admin-site-header-inner">
<a class="admin-site-logo" href="${pageContext.request.contextPath}/index.jsp">Travel<span>Tourism</span></a>
<span class="admin-area-label">ADMIN</span>
<nav aria-label="Admin sections">
<a href="${pageContext.request.contextPath}/admin/tours" <%= request.getAttribute("adminSection").equals("tours") ? "aria-current=\"page\"" : "" %>>Destinations</a>
<a href="${pageContext.request.contextPath}/admin/holidays" <%= request.getAttribute("adminSection").equals("holidays") ? "aria-current=\"page\"" : "" %>>Customized Holidays</a>
</nav>
<a class="admin-website-link" href="${pageContext.request.contextPath}/index.jsp" target="_blank" rel="noopener">View website &#8599;</a>
</div></header>